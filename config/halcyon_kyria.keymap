/*
 * Ported from the QMK `glassbricks` keymap for the wired Halcyon Kyria rev4.
 * Source of truth: qmk_userspace/keyboards/splitkb/halcyon/kyria/keymaps/glassbricks/keymap.c
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/*
 * Layer order is the priority mechanism: ZMK scans active layers from the
 * highest index down. MAC sits below GAME and every momentary layer so that it
 * can only rewrite positions BASE owns, and so GAME's explicit &kp LCTRL wins
 * over it.
 */
#define BASE    0
#define MAC     1
#define GAME    2
#define NUM     3
#define SYM     4
#define EXT     5
#define FUN     6
#define ADJ     7
#define MAC_EXT 8
#define MAC_FUN 9

/*
 * `#binding-cells` cannot be written inside a function-like macro body: the
 * preprocessor reads a bare `#` there as the stringize operator. Object-like
 * macros carry no such restriction.
 */
#define BINDING_CELLS_0 #binding-cells = <0>

/* QMK's custom_shift_keys[]: shift is a no-op on these keys. */
#define NOSHIFT(NAME, KEY) \
    NAME: NAME { \
        compatible = "zmk,behavior-mod-morph"; \
        BINDING_CELLS_0; \
        bindings = <&kp KEY>, <&kp KEY>; \
        mods = <(MOD_LSFT|MOD_RSFT)>; \
    };

/* QMK ONESHOT_TIMEOUT */
&sk {
    release-after-ms = <500>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        mac_ext {
            if-layers = <MAC EXT>;
            then-layer = <MAC_EXT>;
        };

        mac_fun {
            if-layers = <MAC FUN>;
            then-layer = <MAC_FUN>;
        };
    };

    behaviors {
        NOSHIFT(ns_grave, GRAVE)
        NOSHIFT(ns_n1, N1)
        NOSHIFT(ns_n2, N2)
        NOSHIFT(ns_n3, N3)
        NOSHIFT(ns_n4, N4)
        NOSHIFT(ns_n5, N5)
        NOSHIFT(ns_n6, N6)
        NOSHIFT(ns_n7, N7)
        NOSHIFT(ns_n8, N8)
        NOSHIFT(ns_n9, N9)
        NOSHIFT(ns_n0, N0)
        NOSHIFT(ns_minus, MINUS)
        NOSHIFT(ns_equal, EQUAL)
        NOSHIFT(ns_lbkt, LBKT)
        NOSHIFT(ns_rbkt, RBKT)
        NOSHIFT(ns_bslh, BSLH)
        NOSHIFT(ns_semi, SEMI)
        NOSHIFT(ns_comma, COMMA)
        NOSHIFT(ns_dot, DOT)
        NOSHIFT(ns_fslh, FSLH)

        /* QMK FUN_NUM: momentary FUN, or NUM when shifted. */
        fun_num: fun_num {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mo FUN>, <&mo NUM>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* QMK W_BSPC: W, but backspace while alt is held. */
        w_bspc: w_bspc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp W>, <&kp BSPC>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        /* QMK NUM_BLS = LT(_NUM, KC_BSLS) with hold-on-other-key-press. */
        num_bsls: num_bsls {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&ns_bslh>;
        };

        /* QMK SPC_EXT = LT(_EXT, KC_SPC). */
        spc_ext: spc_ext {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        game_spc: game_spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog GAME &kp SPACE>;
        };

        game_ret: game_ret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog GAME &kp ENTER>;
        };

        inc_dec_scroll: inc_dec_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp F  &kp P  &kp B                                                                  &kp J     &kp L      &kp U      &kp Y     &ns_semi  &kp C_MUTE
&kp ESC    &kp A  &kp R  &kp S  &kp T  &kp G                                                                  &kp M     &kp N      &kp E      &kp I     &kp O     &ns_minus
&kp LCTRL  &kp Z  &kp X  &kp C  &kp D  &kp V  &kp SPACE  &key_repeat        &mo EXT   &kp UNDER               &kp K     &kp H      &ns_comma  &ns_dot   &kp SQT   &kp ENTER
                                &kp LGUI  &kp LALT  &kp LSFT  &mo EXT  &num_bsls NUM 0      &fun_num  &kp SPACE  &mo SYM  &kp RALT  &mo ADJ

&none  &none  &none  &none  &none                                                                             &none  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* Ctrl/Meta swap. Only rewrites positions BASE owns. */
        mac_layer {
            display-name = "MAC";
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans                                                &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans                                                &trans  &trans  &trans  &trans  &trans  &trans
&kp LGUI   &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                   &kp LCTRL  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans

&trans  &trans  &trans  &trans  &trans                                                           &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        game_layer {
            display-name = "GAME";
            bindings = <
&trans     &trans  &w_bspc  &trans  &trans  &trans                                                    &trans  &trans  &trans  &trans  &trans  &trans
&kp ESC    &trans  &trans   &trans  &trans  &trans                                                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &trans  &trans   &trans  &trans  &trans  &kp BSPC  &ns_bslh       &mo EXT  &trans          &trans  &trans  &trans  &trans  &trans  &game_ret
                                    &tog GAME  &tog GAME  &kp LSFT  &kp SPACE  &kp LALT       &mo FUN  &game_spc  &tog GAME  &tog GAME  &tog GAME

&trans  &trans  &trans  &trans  &trans                                                                &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&tog GAME  &tog GAME  &kp LT    &kp GT    &ns_minus  &kp AT                                                     &kp PIPE   &ns_n4  &ns_n5  &ns_n6  &trans     &trans
&kp BSPC   &kp EXCL   &kp STAR  &ns_fslh  &ns_equal  &kp HASH                                                   &kp TILDE  &ns_n1  &ns_n2  &ns_n3  &ns_n0     &trans
&trans     &ns_bslh   &kp PLUS  &ns_lbkt  &ns_rbkt   &kp CARET  &trans  &trans        &ns_comma  &trans          &kp DLLR   &ns_n7  &ns_n8  &ns_n9  &ns_comma  &trans
                                          &trans  &trans  &trans  &spc_ext EXT SPACE  &trans        &ns_dot  &trans  &trans  &trans  &trans

&trans  &trans  &trans  &trans  &trans                                                                          &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&trans    &ns_grave  &kp LT    &kp GT    &ns_minus  &kp AT                                                      &kp PIPE   &kp PRCNT  &kp QMARK  &kp AMPS  &ns_semi  &trans
&kp BSPC  &kp EXCL   &kp STAR  &ns_fslh  &ns_equal  &kp HASH                                                    &kp TILDE  &kp COLON  &kp LPAR   &kp RPAR  &kp RBRC  &trans
&trans    &ns_bslh   &kp PLUS  &ns_lbkt  &ns_rbkt   &kp CARET  &kp UNDER  &trans        &trans  &trans          &kp DLLR   &kp LBRC   &ns_comma  &ns_dot   &kp DQT   &trans
                                         &trans  &trans  &trans  &spc_ext EXT SPACE  &trans        &trans  &trans  &trans  &trans  &trans

&trans  &trans  &trans  &trans  &trans                                                                          &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_scroll SCRL_UP SCRL_DOWN &inc_dec_scroll SCRL_UP SCRL_DOWN &inc_dec_scroll SCRL_UP SCRL_DOWN &inc_dec_scroll SCRL_UP SCRL_DOWN>;
        };

        ext_layer {
            display-name = "EXT";
            bindings = <
&trans   &tog GAME  &kp TAB    &trans     &tog MAC    &kp LC(B)                                              &kp PG_UP  &kp HOME  &kp UP     &kp END    &kp PSCRN  &trans
&trans   &sk LGUI   &sk LALT   &sk LSFT   &sk LCTRL   &kp LC(A)                                              &kp PG_DN  &kp LEFT  &kp DOWN   &kp RIGHT  &kp DEL    &trans
&mo FUN  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp TAB     &kp LC(V)  &trans  &trans        &trans  &trans        &caps_word &kp BSPC  &kp K_APP  &trans     &kp INS    &trans
                                          &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans

&trans  &trans  &trans  &trans  &trans                                                                       &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_scroll SCRL_UP SCRL_DOWN &inc_dec_scroll SCRL_UP SCRL_DOWN &inc_dec_scroll SCRL_UP SCRL_DOWN &inc_dec_scroll SCRL_UP SCRL_DOWN>;
        };

        fun_layer {
            display-name = "FUN";
            bindings = <
&trans  &trans    &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_UP                                   &trans    &kp F4  &kp F5  &kp F6  &trans   &trans
&trans  &sk LGUI  &sk LALT    &sk LSFT          &sk LCTRL   &kp C_VOL_DN                                   &kp F11   &kp F1  &kp F2  &kp F3  &kp F10  &trans
&trans  &trans    &trans      &trans            &trans      &kp C_MUTE  &trans  &trans      &trans  &trans  &trans    &kp F7  &kp F8  &kp F9  &kp F12  &trans
                                                &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans

&trans  &trans  &trans  &trans  &trans                                                                     &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adj_layer {
            display-name = "ADJ";
            bindings = <
&bt BT_CLR    &rgb_ug RGB_SPI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &tog MAC                                         &msc SCRL_UP    &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none  &bootloader
&out OUT_TOG  &rgb_ug RGB_SPD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_TOG                                  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &trans
&trans        &trans           &trans           &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans           &trans  &trans  &trans  &trans  &trans          &mkp MB4        &mkp MCLK       &mkp MB5         &none  &trans
                                                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &trans  &trans  &trans  &trans  &trans

&trans  &trans  &trans  &trans  &trans                                                                                             &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mac_ext_layer {
            display-name = "MAC_EXT";
            bindings = <
&trans  &trans      &trans      &trans      &trans      &kp LG(B)                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &sk LCTRL   &trans      &trans      &sk LGUI    &kp LG(A)                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LG(Z)   &kp LG(X)   &kp LG(C)   &trans      &kp LG(V)  &trans  &trans    &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans
                                            &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans

&trans  &trans  &trans  &trans  &trans                                                                &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_scroll SCRL_UP SCRL_DOWN &inc_dec_scroll SCRL_UP SCRL_DOWN &inc_dec_scroll SCRL_UP SCRL_DOWN &inc_dec_scroll SCRL_UP SCRL_DOWN>;
        };

        mac_fun_layer {
            display-name = "MAC_FUN";
            bindings = <
&trans  &trans      &trans  &trans  &trans    &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &sk LCTRL   &trans  &trans  &sk LGUI  &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans

&trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
